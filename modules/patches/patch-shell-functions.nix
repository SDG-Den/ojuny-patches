/*
  @menu
  displayname = "Shell functions";
  icon = "utilities-terminal-symbolic";
  order = 170;
  description = "Opt-in shell functions ported from omarchy";
  category = "Patches";
  systems = [ "all" ];
*/

{ self, ... }:

let
  mkOptions = lib: {
    shells = lib.mkOption {
      type = lib.types.listOf (
        lib.types.enum [
          "zsh"
          "bash"
        ]
      );
      default = [ "zsh" ];
      description = "Shells that source the generated functions file.";
    };

    compression.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable compress and decompress.";
    };

    sshForwarding.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable fip, dip, and lip.";
    };

    sshReconnect.enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable the ssh reconnect wrapper.";
    };

    worktrees = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable ga and gd.";
      };
      verifyFlake = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Run nix develop -c true in a new worktree with flake.nix.";
      };
    };

    tmux = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable the tmux layout helpers.";
      };
      editorCommand = lib.mkOption {
        type = lib.types.str;
        default = "$EDITOR .";
        description = "Command sent to the tmux editor pane.";
      };
      aiCommand = lib.mkOption {
        type = lib.types.str;
        default = "opencode";
        description = "Command sent to the tmux AI pane.";
      };
      diffCommand = lib.mkOption {
        type = lib.types.str;
        default = "git diff --color=always";
        description = "Command sent to the tmux diff pane.";
      };
    };

    rsync.enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable rsw, lsw, and dsw.";
    };
  };

  mkPackages =
    {
      lib,
      pkgs,
      cfg,
    }:
    lib.optionals cfg.compression.enable [
      pkgs.gnutar
      pkgs.gzip
    ]
    ++ lib.optionals cfg.sshForwarding.enable [
      pkgs.openssh
      pkgs.procps
      pkgs.findutils
    ]
    ++ lib.optionals cfg.sshReconnect.enable [
      pkgs.openssh
      pkgs.gnugrep
    ]
    ++ lib.optionals cfg.worktrees.enable [
      pkgs.git
      pkgs.gawk
    ]
    ++ lib.optionals cfg.tmux.enable [
      pkgs.tmux
      pkgs.git
      pkgs.findutils
    ]
    ++ lib.optionals cfg.rsync.enable [
      pkgs.rsync
      pkgs.inotify-tools
      pkgs.util-linux
      pkgs.openssh
    ];

  mkScript =
    {
      lib,
      pkgs,
      cfg,
    }:
    pkgs.writeText "ojuny-shell-functions.sh" ''
      # shellcheck shell=bash
      # Generated by ojuny patch-shell-functions. Do not edit.
      if [ -n "''${__OJUNY_SHELL_FUNCTIONS_LOADED:-}" ]; then
        return 0 2>/dev/null || exit 0
      fi
      __OJUNY_SHELL_FUNCTIONS_LOADED=1

      __ojuny_runtime_dir() {
        printf '%s/ojuny-shell-functions-%s\n' "''${XDG_RUNTIME_DIR:-/tmp}" "$(id -u)"
      }

      __ojuny_runtime_dir_create() {
        local dir
        dir="$(__ojuny_runtime_dir)"
        mkdir -p "$dir"
        chmod 700 "$dir"
        printf '%s\n' "$dir"
      }

      ${lib.optionalString cfg.compression.enable ''
        compress() {
          if [ "$#" -ne 1 ]; then
            printf 'Usage: compress <path>\n' >&2
            return 1
          fi
          local target="''${1%/}"
          tar -czf "$target.tar.gz" "$target"
        }

        decompress() {
          if [ "$#" -ne 1 ]; then
            printf 'Usage: decompress <archive.tar.gz>\n' >&2
            return 1
          fi
          tar -xzf "$1"
        }
      ''}

      ${lib.optionalString cfg.sshForwarding.enable ''
        __ojuny_ssh_pid_file() {
          printf '%s/ssh-forward-%s.pid\n' "$(__ojuny_runtime_dir_create)" "$1"
        }

        __ojuny_ssh_verify() {
          local pid="$1" port="$2" args
          args="$(ps -p "$pid" -o args= 2>/dev/null)" || return 1
          case "$args" in
            *"ssh"*"-L $port:localhost:$port"*) return 0 ;;
            *) return 1 ;;
          esac
        }

        fip() {
          if [ "$#" -lt 2 ]; then
            printf 'Usage: fip <host> <port1> [port2] ...\n' >&2
            return 1
          fi
          local host="$1" port pid_file pid
          shift
          for port in "$@"; do
            pid_file="$(__ojuny_ssh_pid_file "$port")"
            if [ -f "$pid_file" ]; then
              pid="$(cat "$pid_file")"
              if __ojuny_ssh_verify "$pid" "$port"; then
                printf 'Forwarding already active on port %s (pid %s)\n' "$port" "$pid"
                continue
              fi
              command rm -f "$pid_file"
            fi
            command ssh -N -L "$port:localhost:$port" "$host" &
            pid=$!
            printf '%s\n' "$pid" >"$pid_file"
            printf 'Forwarding localhost:%s -> %s:%s (pid %s)\n' "$port" "$host" "$port" "$pid"
          done
        }

        dip() {
          if [ "$#" -eq 0 ]; then
            printf 'Usage: dip <port1> [port2] ...\n' >&2
            return 1
          fi
          local port pid_file pid
          for port in "$@"; do
            pid_file="$(__ojuny_ssh_pid_file "$port")"
            if [ ! -f "$pid_file" ]; then
              printf 'No forwarding on port %s\n' "$port"
              continue
            fi
            pid="$(cat "$pid_file")"
            if __ojuny_ssh_verify "$pid" "$port"; then
              kill "$pid" 2>/dev/null &&
                printf 'Stopped forwarding port %s (pid %s)\n' "$port" "$pid"
            else
              printf 'No forwarding on port %s\n' "$port"
            fi
            command rm -f "$pid_file"
          done
        }

        lip() {
          local dir pid_file pid port found=0
          dir="$(__ojuny_runtime_dir_create)"
          while IFS= read -r pid_file; do
            [ -n "$pid_file" ] || continue
            pid="$(cat "$pid_file")"
            port="''${pid_file##*-}"
            port="''${port%.pid}"
            if __ojuny_ssh_verify "$pid" "$port"; then
              printf '%s: %s\n' "$pid" "$(ps -p "$pid" -o args=)"
              found=1
            else
              command rm -f "$pid_file"
            fi
          done < <(find "$dir" -maxdepth 1 -type f -name 'ssh-forward-*.pid' 2>/dev/null)
          [ "$found" -eq 1 ] || printf 'No active forwards\n'
        }
      ''}

      ${lib.optionalString cfg.sshReconnect.enable ''
        ssh() {
          local rc started

          started=$SECONDS
          command ssh "$@"
          rc=$?

          [[ -t 1 ]] || return $rc
          _ssh_disarm

          if (( rc != 255 )) || [[ ! -t 0 ]] || ! _ssh_interactive "$@" ||
            (( SECONDS - started < 30 )); then
            return $rc
          fi

          (
            while true; do
              echo "Connection lost. Reconnecting (Ctrl-C to stop)..."
              sleep 2
              command ssh "$@"
              rc=$?
              _ssh_disarm
              (( rc != 255 )) && exit $rc
            done
          )
        }

        _ssh_disarm() {
          printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1004l\e[?1049l\e[?25h'
        }

        _ssh_interactive() {
          local value_opts="BbcDEeFIiJLlmOoPpQRSWw"
          local argv=("$@") arg letters i dest="" opts_done=""

          while (($#)); do
            arg="$1"
            shift

            if [[ -z $opts_done && $arg == "--" ]]; then
              opts_done=1
            elif [[ -z $opts_done && $arg == -?* ]]; then
              letters="''${arg#-}"
              for ((i = 0; i < ''${#letters}; i++)); do
                if [[ $value_opts == *"''${letters:i:1}"* ]]; then
                  (( i == ''${#letters} - 1 )) && shift
                  break
                fi
              done
            elif [[ -z $dest ]]; then
              dest="$arg"
            else
              return 1
            fi
          done

          [[ -n $dest ]] || return 1

          local resolved
          resolved=$(command ssh -G "''${argv[@]}" 2>/dev/null) || return 1
          ! grep -i '^remotecommand ' <<<"$resolved" | grep -qvi '^remotecommand none$'
        }
      ''}

      ${lib.optionalString cfg.worktrees.enable ''
        ga() {
          if [ "$#" -ne 1 ]; then
            printf 'Usage: ga <branch>\n' >&2
            return 1
          fi
          local branch="$1" base wt_path
          base="$(basename "$PWD")"
          wt_path="$(dirname "$PWD")/''${base}--''${branch//\//-}"
          git worktree add -b "$branch" "$wt_path" || return 1
          cd "$wt_path" || return 1
          ${lib.optionalString cfg.worktrees.verifyFlake ''
            if [ -f flake.nix ]; then
              nix develop -c true
            fi
          ''}
        }

        gd() {
          local cwd branch main_wt confirm
          cwd="$(pwd)"
          branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || {
            printf 'Not in a git repository\n' >&2
            return 1
          }
          if [ "$branch" = "HEAD" ]; then
            printf 'Detached HEAD; refusing to delete a branch.\n' >&2
            return 1
          fi
          main_wt="$(git worktree list --porcelain |
            awk '/^worktree / { sub(/^worktree /, ""); print; exit }')"
          if [ -z "$main_wt" ] || [ "$cwd" = "$main_wt" ]; then
            printf 'Run gd from a linked worktree, not the main worktree.\n' >&2
            return 1
          fi
          printf 'Remove worktree %s and branch %s? [y/N] ' "$cwd" "$branch"
          read -r confirm
          case "$confirm" in
            [yY]*) ;;
            *) return 1 ;;
          esac
          cd "$main_wt" || return 1
          git worktree remove "$cwd" || return 1
          git branch -d "$branch"
        }
      ''}

      ${lib.optionalString cfg.tmux.enable ''
        __ojuny_tmux_require() {
          if [ -z "''${TMUX:-}" ]; then
            printf 'You must start tmux to use %s.\n' "$1" >&2
            return 1
          fi
          if ! command -v tmux >/dev/null 2>&1; then
            printf 'tmux is not installed.\n' >&2
            return 1
          fi
        }

        tdl() {
          if [ -z "''${1:-}" ]; then
            printf 'Usage: tdl <c|cx|codex|other_ai> [<second_ai>]\n' >&2
            return 1
          fi
          __ojuny_tmux_require tdl || return 1
          local current_dir="$PWD" editor_pane="$TMUX_PANE"
          local ai="$1" ai2="''${2:-}" ai_pane ai2_pane
          command tmux rename-window -t "$editor_pane" "$(basename "$current_dir")"
          command tmux split-window -v -p 15 -t "$editor_pane" -c "$current_dir"
          ai_pane="$(command tmux split-window -h -p 30 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')"
          if [ -n "$ai2" ]; then
            ai2_pane="$(command tmux split-window -v -t "$ai_pane" -c "$current_dir" -P -F '#{pane_id}')"
            command tmux send-keys -t "$ai2_pane" "$ai2" C-m
          fi
          command tmux send-keys -t "$ai_pane" "$ai" C-m
          command tmux send-keys -t "$editor_pane" ${lib.escapeShellArg cfg.tmux.editorCommand} C-m
          command tmux select-pane -t "$editor_pane"
        }

        tds() {
          if [ "$#" -ne 0 ]; then
            printf 'Usage: tds\n' >&2
            return 1
          fi
          __ojuny_tmux_require tds || return 1
          local current_dir="$PWD" editor_pane="$TMUX_PANE"
          local terminal_pane diff_pane ai_pane
          command tmux rename-window -t "$editor_pane" "$(basename "$current_dir")"
          terminal_pane="$(command tmux split-window -v -p 50 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')"
          diff_pane="$(command tmux split-window -h -p 50 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')"
          ai_pane="$(command tmux split-window -h -p 50 -t "$terminal_pane" -c "$current_dir" -P -F '#{pane_id}')"
          command tmux send-keys -t "$editor_pane" ${lib.escapeShellArg cfg.tmux.editorCommand} C-m
          command tmux send-keys -t "$diff_pane" ${lib.escapeShellArg cfg.tmux.diffCommand} C-m
          command tmux send-keys -t "$ai_pane" ${lib.escapeShellArg cfg.tmux.aiCommand} C-m
          command tmux select-pane -t "$editor_pane"
        }

        tdlm() {
          if [ -z "''${1:-}" ]; then
            printf 'Usage: tdlm <c|cx|codex|other_ai> [<second_ai>]\n' >&2
            return 1
          fi
          __ojuny_tmux_require tdlm || return 1
          local ai="$1" ai2="''${2:-}" base_dir="$PWD" first=1 dir dirpath pane_id cmd
          command tmux rename-session "$(basename "$base_dir" | tr '.:' '--')"
          while IFS= read -r dir; do
            [ -n "$dir" ] || continue
            dirpath="$dir"
            cmd="cd $(printf '%q' "$dirpath") && tdl $(printf '%q' "$ai")"
            if [ -n "$ai2" ]; then
              cmd="$cmd $(printf '%q' "$ai2")"
            fi
            if [ "$first" -eq 1 ]; then
              command tmux send-keys -t "$TMUX_PANE" "$cmd" C-m
              first=0
            else
              pane_id="$(command tmux new-window -c "$dirpath" -P -F '#{pane_id}')"
              command tmux send-keys -t "$pane_id" "$cmd" C-m
            fi
          done < <(find "$base_dir" -mindepth 1 -maxdepth 1 -type d -not -name '.*' 2>/dev/null)
        }

        tsl() {
          if [ "$#" -ne 2 ]; then
            printf 'Usage: tsl <pane_count> <command>\n' >&2
            return 1
          fi
          __ojuny_tmux_require tsl || return 1
          local count="$1" cmd="$2" current_dir="$PWD"
          local first_pane="$TMUX_PANE" last_pane="$TMUX_PANE" new_pane i
          case "$count" in
            "" | *[!0-9]*)
              printf 'Usage: tsl <pane_count> <command>\n' >&2
              return 1
              ;;
          esac
          [ "$count" -ge 1 ] || return 1
          command tmux rename-window -t "$first_pane" "$(basename "$current_dir")"
          command tmux send-keys -t "$first_pane" "$cmd" C-m
          for ((i = 2; i <= count; i++)); do
            new_pane="$(command tmux split-window -h -t "$last_pane" -c "$current_dir" -P -F '#{pane_id}')"
            command tmux select-layout -t "$first_pane" tiled >/dev/null
            command tmux send-keys -t "$new_pane" "$cmd" C-m
            last_pane="$new_pane"
          done
          command tmux select-pane -t "$first_pane"
        }
      ''}

      ${lib.optionalString cfg.rsync.enable ''
        rsw() {
          if [ "$#" -ne 2 ]; then
            printf 'Usage: rsw <source> <destination>\n' >&2
            return 1
          fi
          if ! command -v inotifywait >/dev/null 2>&1; then
            printf 'inotifywait is not installed.\n' >&2
            return 1
          fi
          local src="''${1%/}" dest="$2" dir state pid_file pid rsh i
          dir="$(__ojuny_runtime_dir_create)"
          state="$dir/rsync-watches.state"
          pid_file="$(mktemp "$dir/rsw-XXXXXX.pid")"
          rsh="ssh -o ControlMaster=auto -o ControlPath=$dir/rsw-%r@%h:%p -o ControlPersist=yes"
          setsid --fork env RSYNC_RSH="$rsh" sh -c '
            printf "%s\n" "$$" > "$3"
            printf "%s\t%s\t%s\n" "$$" "$1" "$2" >> "$4"
            rsync -a "$1/" "$2"
            while inotifywait -r -q -e modify,create,delete,move "$1"; do
              rsync -a "$1/" "$2"
            done
          ' rsw-watch "$src" "$dest" "$pid_file" "$state" >/dev/null 2>&1
          for i in 1 2 3 4 5; do
            [ -s "$pid_file" ] && break
            sleep 0.1
          done
          pid="$(cat "$pid_file" 2>/dev/null || true)"
          command rm -f "$pid_file"
          if [ -z "$pid" ]; then
            printf 'Failed to start rsync watcher.\n' >&2
            return 1
          fi
          printf 'Watching %s -> %s (pid %s)\n' "$src" "$dest" "$pid"
        }

        lsw() {
          local dir state pid src dest found=0
          dir="$(__ojuny_runtime_dir_create)"
          state="$dir/rsync-watches.state"
          if [ ! -f "$state" ]; then
            printf 'No active watches\n'
            return 0
          fi
          while IFS="$(printf '\t')" read -r pid src dest; do
            [ -n "$pid" ] || continue
            if kill -0 "$pid" 2>/dev/null; then
              printf '%s: %s -> %s\n' "$pid" "$src" "$dest"
              found=1
            fi
          done <"$state"
          [ "$found" -eq 1 ] || printf 'No active watches\n'
        }

        dsw() {
          local dir state tmp pid src dest found=0
          dir="$(__ojuny_runtime_dir_create)"
          state="$dir/rsync-watches.state"
          if [ ! -f "$state" ]; then
            printf 'No active watches\n'
            return 0
          fi
          tmp="$state.$$"
          : >"$tmp"
          while IFS="$(printf '\t')" read -r pid src dest; do
            [ -n "$pid" ] || continue
            if kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null; then
              printf 'Stopped %s -> %s (pid %s)\n' "$src" "$dest" "$pid"
              found=1
            elif kill -0 "$pid" 2>/dev/null; then
              printf '%s\t%s\t%s\n' "$pid" "$src" "$dest" >>"$tmp"
            fi
          done <"$state"
          if [ -s "$tmp" ]; then
            command mv -f "$tmp" "$state"
          else
            command rm -f "$tmp" "$state"
          fi
          [ "$found" -eq 1 ] || printf 'No active watches\n'
        }
      ''}
    '';
in
{
  flake.modules.nixos.patch-shell-functions =
    { config, lib, ... }:
    {
      options.ojuny.patch.shellFunctions.enable = lib.mkEnableOption "the shell-functions patch";

      imports = [ self.modules.nixos.shell-functions-backend ];

      config = {
        # @option widget = "switch"; label = "Shell functions"; group = "Patches"; description = "Enable the shell-functions patch.";
        ojuny.patch.shellFunctions.enable = false;

        # @option widget = "list"; label = "Shells"; group = "Shell functions"; groupOrder = 5; choices = [ "zsh" "bash" ]; description = "Shells that source the generated functions file."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.shells = [ "zsh" ];

        # @option widget = "switch"; label = "Compression"; group = "Compression"; groupOrder = 10; order = 10; description = "compress and decompress with tar.gz."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.compression.enable = true;

        # @option widget = "switch"; label = "SSH port forwarding"; group = "SSH"; groupOrder = 20; order = 10; description = "fip, dip, and lip with PID-file tracking."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.sshForwarding.enable = true;

        # @option widget = "switch"; label = "SSH reconnect"; group = "SSH"; groupOrder = 20; order = 20; description = "Shadow ssh with a reconnect wrapper that disarms terminal modes. Off by default."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.sshReconnect.enable = false;

        # @option widget = "switch"; label = "Git worktrees"; group = "Git worktrees"; groupOrder = 30; order = 10; description = "ga and gd without mise or gum."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.worktrees.enable = true;

        # @option widget = "switch"; label = "Verify flake"; group = "Git worktrees"; groupOrder = 30; order = 20; description = "Run nix develop -c true in a new worktree that contains flake.nix."; visibleWhen.path = "ojuny.patch.shellFunctions.worktrees.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.worktrees.verifyFlake = false;

        # @option widget = "switch"; label = "tmux layouts"; group = "tmux"; groupOrder = 40; order = 10; description = "tdl, tds, tdlm, and tsl."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.tmux.enable = true;

        # @option widget = "text"; label = "Editor command"; group = "tmux"; groupOrder = 40; order = 20; description = "Command sent to the editor pane."; visibleWhen.path = "ojuny.patch.shellFunctions.tmux.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.tmux.editorCommand = "$EDITOR .";

        # @option widget = "text"; label = "AI command"; group = "tmux"; groupOrder = 40; order = 30; description = "Command sent to the AI pane."; visibleWhen.path = "ojuny.patch.shellFunctions.tmux.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.tmux.aiCommand = "opencode";

        # @option widget = "text"; label = "Diff command"; group = "tmux"; groupOrder = 40; order = 40; description = "Command sent to the diff pane."; visibleWhen.path = "ojuny.patch.shellFunctions.tmux.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.tmux.diffCommand = "git diff --color=always";

        # @option widget = "switch"; label = "rsync watchers"; group = "rsync"; groupOrder = 50; order = 10; description = "rsw, lsw, and dsw. Starts background watchers. Off by default."; visibleWhen.path = "ojuny.patch.shellFunctions.enable"; visibleWhen.equals = true;
        ojuny.patch.shellFunctions.rsync.enable = false;

        home-manager.sharedModules = lib.mkIf (
          config.ojuny.patch.shellFunctions.enable && (config.ojuny.patches or true)
        ) [ self.modules.homeManager.shell-functions-backend ];
      };
    };

  flake.modules.nixos.shell-functions-backend =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      cfg = config.ojuny.patch.shellFunctions;
      active = cfg.enable && (config.ojuny.patches or true);
    in
    {
      options.ojuny.patch.shellFunctions = mkOptions lib;

      config = lib.mkIf active {
          environment.etc."ojuny/shell-functions.sh".source = mkScript { inherit lib pkgs cfg; };

          environment.systemPackages = mkPackages { inherit lib pkgs cfg; };

          programs.zsh.interactiveShellInit = lib.mkIf (lib.elem "zsh" cfg.shells) ''
            source /etc/ojuny/shell-functions.sh
          '';

          programs.bash.interactiveShellInit = lib.mkIf (lib.elem "bash" cfg.shells) ''
            source /etc/ojuny/shell-functions.sh
          '';
      };
    };

  flake.modules.homeManager.shell-functions-backend =
    {
      lib,
      pkgs,
      osConfig,
      ...
    }:
    let
      cfg = osConfig.ojuny.patch.shellFunctions;
    in
    {
      config = lib.mkIf (cfg.enable && (osConfig.ojuny.patches or true)) {
        home.file.".config/ojuny/shell-functions.sh".source = mkScript { inherit lib pkgs cfg; };

        home.packages = mkPackages { inherit lib pkgs cfg; };

        programs.zsh.initExtra = lib.mkIf (lib.elem "zsh" cfg.shells) ''
          source "$HOME/.config/ojuny/shell-functions.sh"
        '';

        programs.bash.initExtra = lib.mkIf (lib.elem "bash" cfg.shells) ''
          source "$HOME/.config/ojuny/shell-functions.sh"
        '';
      };
    };
}
